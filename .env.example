# 复制为 .env 后按实际情况修改：  cp .env.example .env

# ── 模型接入（必填）──────────────────────────────────────────────────────
# 地址是否带 /v1 取决于服务端实现，两种情况不一样：
#
#   · 官方 DeepSeek API —— 不带 /v1：
#       DSH_LLM_BASE_URL=https://api.deepseek.com
#   · 自建推理服务（vLLM / SGLang / Ollama / one-api）—— 通常要带 /v1：
#       DSH_LLM_BASE_URL=http://10.0.0.5:8000/v1
#
# 判断方法：在服务器上执行下面这条，返回模型列表的那个地址就是对的。
#   curl -H "Authorization: Bearer 你的密钥" <地址>/models
DSH_LLM_BASE_URL=http://10.0.0.5:8000/v1

# 模型服务要求的密钥。自建服务若不做校验，保持默认占位值即可。
DSH_LLM_API_KEY=sk-intranet

# 默认使用的模型 ID（必须是服务端真实存在的名字，写错会直接报错）
#   官方 API：deepseek-flash（快、便宜）或 deepseek-v4-pro（强）
#   自建服务：以该服务实际部署的模型名为准
DSH_LLM_MODEL=deepseek-chat

# 可选：额外暴露给用户切换的模型，逗号分隔，可用「id:显示名」指定别名。
# 留空则只暴露 DSH_LLM_MODEL 一个。
# DSH_LLM_MODELS=deepseek-chat:DeepSeek Chat,deepseek-reasoner:DeepSeek R1

# 在界面上显示的模型服务名称
DSH_LLM_PROVIDER_LABEL=内网 DeepSeek

# 模型上下文窗口与单次最大输出 token。务必与模型服务实际配置一致，
# 填过大会导致请求被服务端拒绝。
DSH_LLM_CONTEXT_WINDOW=131072
DSH_LLM_MAX_TOKENS=8192

# ── 兼容开关 ────────────────────────────────────────────────────────────
# 多数内网推理服务不完全兼容 OpenAI 的最新字段，以下三项是最常见的调整点：
#   如果服务端报错提到 developer role / 不支持该 role，保持 false；
#   如果服务端报错提到 max_completion_tokens，改为 max_completion_tokens；
#   如果服务端支持 DeepSeek 的思考模式，可设为 deepseek。
DSH_LLM_SUPPORTS_DEVELOPER_ROLE=false
DSH_LLM_MAX_TOKENS_FIELD=max_tokens
# DSH_LLM_THINKING_FORMAT=deepseek

# ── 授权与容量 ──────────────────────────────────────────────────────────
# 登录状态保持时长（小时）
GATEWAY_SESSION_TTL_HOURS=12

# 用户多久无操作后回收其专属实例（分钟）。工作目录与会话历史会保留，
# 下次登录自动重新拉起。
GATEWAY_IDLE_MINUTES=30

# 同时在线人数上限。每个在线用户约占 200–300MB 内存。
GATEWAY_MAX_INSTANCES=10
