# 配置模板 —— 复制为 .env 后按实际情况修改：
#
#     cp .env.example .env
#
# .env 已被 .gitignore 排除，密钥写在那里不会进入 git 仓库。
# docker-compose.yml 只定义结构，所有具体取值都来自本文件。

# ── 镜像与端口 ──────────────────────────────────────────────────────────
# 本地构建的镜像；若用 Docker Hub 上的公开镜像，改成：
#   DSH_IMAGE=dockertest416/dsh-harness:0.1.5-rc.1
DSH_IMAGE=dsh-harness:0.1.5-rc.1

# 宿主机对外端口
DSH_PORT=8080

# ── 模型接入（唯一必填项）────────────────────────────────────────────────
# 地址要不要带 /v1 取决于服务端实现，两种情况不一样：
#
#   · 官方 DeepSeek API —— 不带 /v1：
#       DSH_LLM_BASE_URL=https://api.deepseek.com
#   · 自建推理服务（vLLM / SGLang / Ollama / one-api）—— 通常要带 /v1：
#       DSH_LLM_BASE_URL=http://10.0.0.5:8000/v1
#
# 判断方法：在能访问该服务的机器上执行下面这条，返回模型列表的地址就是对的。
#   curl -H "Authorization: Bearer 你的密钥" <地址>/models
DSH_LLM_BASE_URL=http://10.0.0.5:8000/v1

# 模型服务的密钥。自建服务若不做校验，保持占位值即可。
DSH_LLM_API_KEY=sk-intranet

# 默认模型 ID（必须是服务端真实存在的名字，写错会直接报错）
#   官方 API：deepseek-flash（快、便宜）或 deepseek-v4-pro（强）
#   自建服务：以该服务实际部署的模型名为准
DSH_LLM_MODEL=deepseek-chat

# 可选：额外暴露给用户切换的模型，逗号分隔，可用「id:显示名」指定别名。
# 留空则只暴露上面那一个。
# DSH_LLM_MODELS=deepseek-flash:DeepSeek Flash,deepseek-v4-pro:DeepSeek V4 Pro

# 界面上显示的模型服务名称
DSH_LLM_PROVIDER_LABEL=内网 DeepSeek

# 上下文窗口与单次最大输出。填过大会导致请求被服务端拒绝，
# 填过大也会让单次请求更贵——agent 会话很容易把窗口撑满。
DSH_LLM_CONTEXT_WINDOW=131072
DSH_LLM_MAX_TOKENS=32768

# ── 兼容开关（模型服务报错时的调节点）────────────────────────────────────
#   服务端提示不认识 developer role        → 保持 false
#   服务端提示应为 max_completion_tokens   → 改成 max_completion_tokens
DSH_LLM_SUPPORTS_DEVELOPER_ROLE=false
DSH_LLM_MAX_TOKENS_FIELD=max_tokens
# 仅 DeepSeek 系模型需要（思考模式）；其他服务留空
# DSH_LLM_THINKING_FORMAT=deepseek
# DSH_LLM_REASONING_EFFORT=high

# ── 配置归属 ────────────────────────────────────────────────────────────
# 同事能否在「设置 → 模型」里自行改模型？
#   留空（默认）：可以。配置首次由本文件生成，之后同事的修改永久保留。
#   设为 1：不可以。每次启动都用本文件重新生成，统一由管理员管控。
# DSH_CONFIG_OVERWRITE=1

# ── 授权与容量 ──────────────────────────────────────────────────────────
# 登录状态保持时长（小时）
GATEWAY_SESSION_TTL_HOURS=12

# 用户多久无操作后回收其专属实例（分钟）。工作目录与会话历史会保留，
# 下次登录自动重新拉起。
GATEWAY_IDLE_MINUTES=30

# 同时在线人数上限。每个在线用户约占 200–300MB 内存。
GATEWAY_MAX_INSTANCES=10
